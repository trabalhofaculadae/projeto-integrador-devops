# Modelo de configuração do servidor.
# No servidor: copie para .env e preencha. O .env NUNCA vai para o Git.

# Imagem da aplicação no GitHub Container Registry (tudo em minúsculas)
IMAGE=ghcr.io/SEU_USUARIO/projeto-integrador-devops
# Versão em produção. O deploy automático atualiza este valor.
IMAGE_TAG=latest

# Domínio da aplicação e do painel de monitoramento
DOMAIN=meusite.com.br
MONITOR_DOMAIN=monitor.meusite.com.br

# E-mail usado na Let's Encrypt (avisos sobre os certificados)
ACME_EMAIL=seu-email@exemplo.com
